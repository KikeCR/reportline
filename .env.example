# Flask
FLASK_ENV=development
SECRET_KEY=

# MongoDB (Atlas-compatible URI; local docker-compose runs a keyfile-auth
# replica set named rs0 - see docker-compose.yml and README)
MONGODB_URI=mongodb://reportline_app:reportline_app@localhost:27017/reportline?replicaSet=rs0&authSource=reportline
MONGODB_DB_NAME=reportline
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_SLOW_QUERY_THRESHOLD_MS=100

# Auth (JWT)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# LLM provider (Phase 7). Leave blank to use the deterministic fake provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Logging
LOG_LEVEL=INFO
