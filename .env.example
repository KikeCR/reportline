# Flask
FLASK_ENV=development
SECRET_KEY=

# MongoDB (a single-node replica set is required - transactions and
# $graphLookup don't work otherwise - but there's no auth in the local setup;
# see docker-compose.yml and README's "Running it locally")
MONGODB_URI=mongodb://localhost:27017/reportline?directConnection=true
MONGODB_DB_NAME=reportline
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_SLOW_QUERY_THRESHOLD_MS=100

# Logging
LOG_LEVEL=INFO
