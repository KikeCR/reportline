            "example": "507f1f77bcf86cd799439011",
            "in": "header",
            "name": "x_org_id",
            "required": true,
            "schema": {
              "description": "Interim pre-auth tenant id - replaced by a JWT claim in Phase 4",
              "example": "507f1f77bcf86cd799439011",
              "format": "objectid",
              "title": "X Org Id",
              "type": "string"
            }
          },
          {
            "example": "507f1f77bcf86cd799439011",
            "in": "path",
            "name": "employee_id",
            "required": true,
            "schema": {
              "example": "507f1f77bcf86cd799439011",
              "format": "objectid",
              "title": "Employee Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeePublicOut"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get an employee (public view)",
        "tags": [
          "default"
        ]
      }
    },
